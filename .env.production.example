# ============================================================
# 生产环境变量模板
# 复制为 .env 并填入真实值（.env 不提交到 git）
#   cp .env.production.example .env
# ============================================================

# ---- 数据库 ----
DB_USER=mindai_app
DB_PASSWORD=请替换为强密码

# ---- JWT 密钥（至少 32 位随机字符串）----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=请替换为随机生成的密钥

# ---- AI 服务 ----
AI_API_KEY=请替换为硅基流动API_KEY
AI_BASE_URL=https://api.siliconflow.cn

# ---- 可选：JVM 调参 ----
# JAVA_OPTS=-Xms512m -Xmx1g
